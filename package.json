{
  "displayName": "Homebridge EnvisaLink (Fork)",
  "name": "@brandonarrindell/homebridge-envisalink",
  "version": "1.3.0",
  "description": "A homebridge plugin for the EnvisaLink alarm module - Maintained fork of homebridge-envisalink",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build && npm run test",
    "test": "jest --forceExit --detectOpenHandles --testTimeout=10000"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge envisalink",
    "homebridge envisa link",
    "homebridge dsc envisalink",
    "homekit dsc",
    "homekit envisalink",
    "homekit dsc envisalink"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brandonarrindell/homebridge-envisalink"
  },
  "author": {
    "name": "Brandon Arrindell",
    "url": "https://github.com/brandonarrindell"
  },
  "contributors": [
    {
      "name": "Dustin D. Clark",
      "url": "https://github.com/dustindclark"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brandonarrindell/homebridge-envisalink/issues"
  },
  "engines": {
    "node": ">=14.18.1",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0"
  },
  "dependencies": {
    "dateformat": ">=1.0.12 <5.0",
    "net": ">=1.0",
    "nodealarmproxy": "https://github.com/dustindclark/NodeAlarmProxy/tarball/0abdfe688451cc57b0bbd64cf54e38e54a2d2a67"
  },
  "devDependencies": {
    "@types/node": "^20.1.0",
    "@types/jest": "^27.0.3",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^8.40.0",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0", 
    "nodemon": "^2.0.20",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4",
    "jest": "^27.3.1",
    "ts-jest": "^27.0.7"
  },
  "homepage": "https://github.com/brandonarrindell/homebridge-envisalink#readme",
